{
  "name": "TB Document",
  "doctype": "DocType",
  "module": "Ticketbrain",
  "custom": 0,
  "is_submittable": 0,
  "autoname": "TB-DOC-.#####",
  "title_field": "title",
  "search_fields": "title,status",
  "in_create": 1,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Document Title",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "document_file",
      "fieldtype": "Attach",
      "label": "Upload File (PDF / DOCX / TXT)",
      "reqd": 1,
      "description": "Supported: PDF, DOCX, TXT. Will be automatically chunked and added to the AI knowledge base."
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Indexing Status",
      "options": "Pending\nProcessing\nIndexed\nFailed",
      "default": "Pending",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "chunk_count",
      "fieldtype": "Int",
      "label": "Chunks Indexed",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "section_notes",
      "fieldtype": "Section Break",
      "label": "Notes"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "Notes",
      "description": "Optional context about this document (owner, version, scope)."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1, "write": 1, "create": 1, "delete": 1
    },
    {
      "role": "Helpdesk Manager",
      "read": 1, "write": 1, "create": 1
    },
    {
      "role": "Helpdesk Agent",
      "read": 1, "create": 1
    }
  ],
  "links": [],
  "actions": []
}
